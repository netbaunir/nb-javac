<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
  http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.netbaunir</groupId>
    <artifactId>nb-javac</artifactId>
    <version>@version@</version>
    <packaging>jar</packaging>

    <name>nb-javac</name>
    <description>
        `nb-javac` is a "backport" of OpenJDK `javac`, i.e., the Java compiler.
        It allows to run the latest OpenJDK compiler on older JDKs while being
        1:1 identical with the official `javac`.
    </description>
    <url>https://github.com/netbaunir/nb-javac</url>

    <licenses>
        <license>
            <name>GPLv2-CPE</name>
            <url>https://openjdk.java.net/legal/gplv2+ce.html</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/netbaunir/nb-javac.git</connection>
        <developerConnection>scm:git:git@github.com:netbaunir/nb-javac.git</developerConnection>
        <url>https://github.com/netbaunir/nb-javac</url>
    </scm>

    <developers>
        <developer>
            <name>netbaunir contributors</name>
            <!-- temporary: personal contact until the org has its own address -->
            <email>mbien42@gmail.com</email>
        </developer>
    </developers>

</project>
